<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep the fork buildable from public sources only.
       The upstream repo has no nuget.config, so a build resolves sources from the
       user-level config. When this fork is consumed as a submodule from another
       repository, the user-level config of whoever builds it would leak in (for
       example a private feed that requires credentials and fails with 401), which
       breaks restoring the SourceGen analyzer's Roslyn packages.

       A single source is deliberate: this repo uses central package management
       (Directory.Packages.props), and NuGet emits NU1507 when more than one source
       is defined without a matching package source mapping. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
